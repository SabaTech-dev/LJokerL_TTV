# LJokerL_TTV — variables de entorno opcionales.
# Estas variables se definen como variables de entorno del proceso o del sistema; la aplicación no carga ningún fichero .env (este fichero es una plantilla de referencia).

# Ejecutable PowerShell alternativo (solo lo usan ExecutionEngine y HardwareDetector; los demás detectores lanzan powershell directamente).
LJOKERL_POWERSHELL_PATH=

# Rutas alternativas de configuración, registro y resultados (opcional).
LJOKERL_CONFIG_PATH=
LJOKERL_LOG_PATH=
LJOKERL_SETTINGS_PATH=
LJOKERL_METRICS_LOG_PATH=
LJOKERL_BENCHMARK_RESULTS_PATH=

# Override del estado VRR detectado (fuerza el valor de la detección de hardware; lo leen HardwareDetector y MainViewModel).
# Valores aceptados (insensible a mayúsculas): 1/true/yes/on habilita, 0/false/no/off deshabilita; cualquier otro valor se ignora.
LJOKERL_VRR_OVERRIDE=

# Ruta alternativa para la exportación de logs.
LJOKERL_LOG_EXPORT_PATH=
