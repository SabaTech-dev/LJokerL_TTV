# LJokerL_TTV — variables de entorno opcionales.
# Copia este fichero a .env si necesitas personalizar las rutas (no es necesario para el uso normal).

# Ejecutable PowerShell alternativo (solo lo usan ExecutionEngine y HardwareDetector; los demás detectores lanzan powershell.exe directamente).
LJOKERL_POWERSHELL_PATH=

# Rutas alternativas de configuración, registro y resultados (opcional).
LJOKERL_CONFIG_PATH=
LJOKERL_LOG_PATH=
LJOKERL_SETTINGS_PATH=
LJOKERL_METRICS_LOG_PATH=
LJOKERL_BENCHMARK_RESULTS_PATH=
