{
  "$schema": "https://opencode.ai/config.json",
  
  "model": "opencode/kimi-k2-5",
  "small_model": "opencode/kimi-k2-5",
  
  "instructions": [
    ".opencode/AGENTS.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    ".opencode/skills/meta/skill-discovery/SKILL.md",
    ".opencode/skills/meta/external-skill-loader/SKILL.md",
    ".opencode/skills/meta/agent-orchestrator/SKILL.md"
  ],
  
  "provider": {
    "opencode": {
      "options": { "timeout": 600000 }
    },
    "github": {
      "options": { "timeout": 600000 }
    },
    "zai": {
      "options": { "timeout": 600000 }
    }
  },
  
  "skill": {
    "autoLoad": [
      "skill-discovery",
      "skill-creator",
      "external-skill-loader",
      "agent-orchestrator"
    ],
    "external": {
      "repository": "https://github.com/sickn33/antigravity-awesome-skills",
      "path": ".opencode/skills/external/antigravity-awesome-skills",
      "enabled": true,
      "lazyLoad": true,
      "whitelist": ["dotnet-csharp", "wpf-mvvm", "windows-optimization", "registry-security", "code-review", "testing", "documentation", "security-audit"]
    },
    "priorities": {
      "security": [
        "registry-security",
        "security-audit"
      ],
      "dotnet": [
        "dotnet-csharp"
      ],
      "wpf": [
        "wpf-mvvm"
      ],
      "testing": [
        "testing"
      ]
    }
  },
  
  "agent": {
    "skill-manager": {
      "description": "Gestiona skills internas y carga desde repositorio externo",
      "mode": "subagent",
      "model": "opencode/kimi-k2-5",
      "skills": ["skill-discovery", "skill-creator", "external-skill-loader"],
      "tools": { "read": true, "write": true, "bash": true }
    },
    "agent-dispatcher": {
      "description": "Analiza la tarea y asigna el agente especializado adecuado",
      "mode": "subagent",
      "model": "opencode/kimi-k2-5",
      "skills": ["agent-orchestrator"],
      "tools": { "read": true }
    },
    "code-reviewer": {
      "description": "Revisa código C# con estándares .NET 9, MVVM y best practices",
      "mode": "subagent",
      "model": "github/gpt-5.3-codex",
      "skills": ["code-review", "dotnet-csharp", "wpf-mvvm"],
      "tools": { "read": true, "grep": true },
      "rules": [".opencode/skills/task/code-review/best-practices.md"]
    },
    "security-auditor": {
      "description": "Audita cambios en registry, permisos admin y operaciones críticas",
      "mode": "subagent",
      "model": "github/gpt-5.3-codex",
      "skills": ["security-audit", "registry-security"],
      "tools": { "read": true, "grep": true },
      "rules": [".opencode/skills/task/security-audit/checklist.md"]
    },
    "test-engineer": {
      "description": "Diseña y ejecuta tests unitarios e integración para C#",
      "mode": "subagent",
      "model": "opencode/glm-5",
      "skills": ["testing", "dotnet-csharp"],
      "tools": { "read": true, "bash": true }
    },
    "technical-writer": {
      "description": "Actualiza documentación del proyecto, README y guías",
      "mode": "subagent",
      "model": "opencode/glm-5",
      "skills": ["documentation"],
      "tools": { "read": true, "edit": true, "write": true }
    },
    "wpf-developer": {
      "description": "Desarrolla interfaces WPF con MVVM, XAML y patrones modernos",
      "mode": "subagent",
      "model": "opencode/kimi-k2-5",
      "skills": ["wpf-mvvm", "dotnet-csharp"],
      "tools": { "read": true, "edit": true }
    },
    "optimization-engineer": {
      "description": "Implementa optimizaciones Windows, tweaks y gestión de servicios",
      "mode": "subagent",
      "model": "opencode/kimi-k2-5",
      "skills": ["windows-optimization", "registry-security"],
      "tools": { "read": true, "edit": true }
    }
  },
  
  "command": {
    "find-skill": {
      "description": "Buscar skills disponibles para una tarea específica",
      "template": "Usa skill-discovery para encontrar skills relevantes para: $ARGUMENTS",
      "agent": "skill-manager"
    },
    "create-skill": {
      "description": "Crear una nueva skill según necesidad detectada",
      "template": "Usa skill-creator para generar una skill para: $ARGUMENTS",
      "agent": "skill-manager"
    },
    "assign-agent": {
      "description": "Asignar el mejor agente para una tarea",
      "template": "Usa agent-orchestrator para determinar el agente adecuado para: $ARGUMENTS",
      "agent": "agent-dispatcher"
    },
    "load-external-skills": {
      "description": "Carga skills específicas del repositorio externo",
      "template": "Usa external-skill-loader para cargar skills sobre: $ARGUMENTS",
      "agent": "skill-manager"
    },
    "update-skills": {
      "description": "Actualiza el repositorio de skills externo",
      "template": "Ejecuta git pull en .opencode/skills/external/antigravity-awesome-skills",
      "agent": "skill-manager"
    },
    "review": {
      "description": "Revisión profunda de código con best practices",
      "template": "Realiza una revisión exhaustiva del código con las reglas definidas",
      "agent": "code-reviewer"
    },
    "audit": {
      "description": "Auditoría de seguridad de cambios",
      "template": "Audita los cambios pendientes enfocándote en seguridad",
      "agent": "security-auditor"
    },
    "test": {
      "description": "Ejecutar tests con estrategia óptima",
      "template": "Ejecuta tests y analiza cobertura",
      "agent": "test-engineer"
    },
    "docs": {
      "description": "Actualizar documentación",
      "template": "Actualiza la documentación relevante",
      "agent": "technical-writer"
    }
  },
  
  "lsp": {
    "csharp": { "disabled": false }
  },
  
  "formatter": {
    "dotnet-format": {
      "command": ["dotnet", "format", "$FILE"],
      "extensions": [".cs", ".csproj"]
    }
  }
}
