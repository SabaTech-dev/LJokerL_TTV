<Window x:Class="LJokerL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LJokerL.App"
        mc:Ignorable="d"
        Title="LJokerL Control Center" 
        Height="800" Width="1280" 
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundSecondaryBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LJokerL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text=" Control Center" FontSize="28" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU: " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CpuUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU: " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding GpuUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM: " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding MemoryUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <RadioButton x:Name="TabDashboard" Content="🏠 Dashboard" IsChecked="True" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabAutoConfig" Content="⚡ Auto Config" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabProfiles" Content="📦 Perfiles" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabTweaks" Content="🔧 Tweaks" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabMonitor" Content="📊 Monitor" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabBenchmarks" Content="⏱️ Benchmarks" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
                <RadioButton x:Name="TabSettings" Content="⚙️ Settings" Style="{StaticResource TabRadioButton}" GroupName="MainTabs"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="24">
            <!-- Dashboard View -->
            <Grid x:Name="DashboardView">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=TabDashboard}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hardware Detected Card -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔍 HARDWARE DETECTADO" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding HardwareSummary}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="GPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding GpuNameLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                            <TextBlock Text="{Binding GpuVramLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MemoryUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Storage" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding DiskUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Monitor" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MonitoringStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                        </StackPanel>
                        
                        <Button Content="🔄 Re-escanear" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Quick Actions / Profiles -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🎮 QUICK PROFILES" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundTertiaryBrush}" 
                                            CornerRadius="10" Padding="16,12" Margin="0,0,12,12"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="120"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="🚀 Apply Selected" Style="{StaticResource GamingButton}" Command="{Binding ApplySelectedProfileCommand}" Margin="0,0,12,0"/>
                            <Button Content="↩️ Revert" Style="{StaticResource SecondaryButton}" Command="{Binding RevertSelectedProfileCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recommendations -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="💡 RECOMMENDATIONS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding RecommendationsStatus}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RuleId}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="📊 STATUS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastActionStatus}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Monitoring -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="📊 MONITORING" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentYellowBrush}"/>
                            <TextBlock Text=" - " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding MonitoringStatus}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CpuUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BackgroundTertiaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="GPU" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding GpuUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding GpuUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentSecondaryBrush}" Background="{StaticResource BackgroundTertiaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Memory" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding MemoryUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource BackgroundTertiaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Disk" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DiskUsageLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding DiskUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource BackgroundTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="{Binding MonitoringToggleLabel}" Style="{StaticResource GamingButton}" Command="{Binding ToggleMonitoringCommand}" Margin="0,0,12,0"/>
                            <CheckBox Content="Log metrics" IsChecked="{Binding MetricsLoggingEnabled}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <CheckBox Content="Crear punto de restauración antes de aplicar" IsChecked="{Binding CreateRestorePointBeforeApply}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Benchmarks View -->
            <Grid x:Name="BenchmarksView">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=TabBenchmarks}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Execution & Controls -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="⏱️ EJECUTAR PRUEBAS DE RENDIMIENTO" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Mide el rendimiento de tu sistema antes y después de aplicar perfiles de optimización." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- Action Buttons -->
                        <Button Content="⚡ Benchmark Rápido" Style="{StaticResource GamingButton}" Command="{Binding RunQuickBenchmarkCommand}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                        <Button Content="🔥 Benchmark Completo" Style="{StaticResource SecondaryButton}" Command="{Binding RunFullBenchmarkCommand}" Margin="0,0,0,24" HorizontalAlignment="Stretch"/>

                        <!-- Progress Bar & Labels -->
                        <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Progreso del Benchmark" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BenchmarkProgressLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                <ProgressBar Value="{Binding BenchmarkProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BackgroundPrimaryBrush}"/>
                                <TextBlock Text="{Binding BenchmarkProgressPercent, StringFormat={}{0}%}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Estado del Sistema:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding BenchmarkStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right Panel: Comparisons & Export -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📊 COMPARAR &amp; EXPORTAR REPORTE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,16"/>

                        <!-- Selection Area -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Run Anterior (Antes):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding BenchmarkRuns}" SelectedItem="{Binding SelectedBenchmarkBefore}" DisplayMemberPath="FileName" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Run Posterior (Después):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding BenchmarkRuns}" SelectedItem="{Binding SelectedBenchmarkAfter}" DisplayMemberPath="FileName" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Preview Area -->
                        <Border Grid.Row="2" Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Vista Previa de la Comparación" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding BenchmarkComparisonSummary}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" FontFamily="Consolas"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚖️ Comparar" Style="{StaticResource SecondaryButton}" Command="{Binding CompareBenchmarksCommand}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="🏆 Reporte Profesional" Style="{StaticResource GamingButton}" Command="{Binding ExportComparisonReportCommand}" Margin="6,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
